<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SwiftList.Core</AssemblyName>
    <RootNamespace>SwiftList.Core</RootNamespace>
    <Version>2.4.0</Version>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- IndexV2 reads its memory-mapped snapshot through typed spans over a raw view pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PluginSdk\PluginSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SwiftList.Core.Tests" />
  </ItemGroup>

</Project>

