<Window x:Class="SwiftList.App.Views.LocalSend.LocalSendReceiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SwiftList.App.Services"
        xmlns:helpers="clr-namespace:SwiftList.App.Helpers.Visuals"
        Title="LocalSend"
        Height="390" Width="460" MinWidth="420" MinHeight="310"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles/Windows/SearchWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12" Background="{DynamicResource ContentBg}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.25" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <Border CornerRadius="12" helpers:RoundedClip.IsEnabled="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Title Bar -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Image x:Name="TitleBarLogo" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtWindowTitle"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_UploadRequestTitle]}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- STEP 1: Request Confirmation View -->
                <Grid x:Name="GridRequestStep" Grid.Row="1" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="54"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,16,8">
                        <StackPanel>
                            <TextBlock x:Name="TxtSender" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary2}"/>
                            <TextBlock x:Name="TxtSummary" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="16,0,16,12" Background="{DynamicResource FieldBackground}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8">
                        <ListBox x:Name="LstFiles" Background="Transparent" BorderThickness="0" Margin="4"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid>
                                                    <Rectangle x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                                               RadiusX="1.5" RadiusY="1.5" Fill="Transparent" Margin="2,4"/>
                                                    <Border x:Name="ItemBorder"
                                                            Background="Transparent"
                                                            CornerRadius="6"
                                                            Padding="8,6"
                                                            Margin="8,2,2,2">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectedBackground}"/>
                                                        <Setter TargetName="AccentBar" Property="Fill" Value="{DynamicResource AccentBarColor}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding FileName}"
                                                   ToolTip="{Binding FileName}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextPrimary2}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SizeText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnDecline" Grid.Column="0" Height="30" Width="80" HorizontalAlignment="Left"
                                    Style="{StaticResource SettingsButton}"
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Decline]}"
                                    Click="BtnDecline_Click"/>

                            <Button x:Name="BtnSaveTo" Grid.Column="1" Height="30" Padding="12,0" Margin="0,0,8,0"
                                    Style="{StaticResource SettingsButton}"
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_SaveTo]}"
                                    Click="BtnSaveTo_Click"/>

                            <Button x:Name="BtnAcceptDefault" Grid.Column="2" Height="30" Padding="16,0"
                                    Style="{StaticResource PrimarySettingsButton}"
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_AcceptDefault]}"
                                    Click="BtnAcceptDefault_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- STEP 2: Progress Transfer View -->
                <Grid x:Name="GridProgressStep" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="54"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,16,20,14">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtProgressStatus"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Receiving]}"
                                       FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary2}" Margin="0,0,0,10"/>

                            <!-- File Name & Right-Aligned Counter Row -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TxtFileName" Grid.Column="0"
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>

                                <TextBlock x:Name="TxtCounter" Grid.Column="1"
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <ProgressBar x:Name="PbTransfer" Height="6" Minimum="0" Maximum="100" Margin="0,0,0,10"/>

                            <TextBlock x:Name="TxtSpeed" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnOpenFolder" Height="30" Padding="12,0" Margin="0,0,8,0" Visibility="Collapsed"
                                    Style="{StaticResource PrimarySettingsButton}"
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_OpenFolder]}"
                                    Click="BtnOpenFolder_Click"/>

                            <Button x:Name="BtnCloseProgress" Height="30" Padding="16,0" Width="80"
                                    Style="{StaticResource SettingsButton}"
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Cancel]}"
                                    Click="BtnCloseProgress_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
