<Window x:Class="SwiftList.App.Views.LocalSend.LocalSendReceiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SwiftList.App.Services"
        Title="LocalSend"
        Height="380" Width="460" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles/Windows/SearchWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1" CornerRadius="8" Margin="4">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="TitleBarLogo" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtWindowTitle"
                               Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_UploadRequestTitle]}"
                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- STEP 1: Request Confirmation View -->
            <Grid x:Name="GridRequestStep" Grid.Row="1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Device & File Summary -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock x:Name="TxtSender" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="TxtSummary" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- File List Preview with Auto Truncation, Tooltip, and Vertical Scrollbar -->
                <Border Grid.Row="1" Background="{DynamicResource ControlBackground}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Margin="0,0,0,16">
                    <ListBox x:Name="LstFiles" Background="Transparent" BorderThickness="0" Margin="4"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding FileName}"
                                               ToolTip="{Binding FileName}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SizeText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Action Buttons Footer for Step 1 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnDecline" Grid.Column="0" Height="32" Width="90" HorizontalAlignment="Left"
                            Style="{StaticResource SettingsButton}"
                            Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Decline]}"
                            Click="BtnDecline_Click"/>

                    <Button x:Name="BtnSaveTo" Grid.Column="1" Height="32" Padding="12,0" Margin="0,0,8,0"
                            Style="{StaticResource SettingsButton}"
                            Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_SaveTo]}"
                            Click="BtnSaveTo_Click"/>

                    <Button x:Name="BtnAcceptDefault" Grid.Column="2" Height="32" Padding="16,0"
                            Style="{StaticResource PrimarySettingsButton}"
                            Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_AcceptDefault]}"
                            Click="BtnAcceptDefault_Click"/>
                </Grid>
            </Grid>

            <!-- STEP 2: Progress Transfer View -->
            <Grid x:Name="GridProgressStep" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Progress Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock x:Name="TxtProgressStatus"
                               Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Receiving]}"
                               FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="TxtFileProgress" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Progress Bar -->
                <ProgressBar x:Name="PbTransfer" Grid.Row="1" Height="6" Minimum="0" Maximum="100" Margin="0,0,0,16"/>

                <!-- Speed / File Info -->
                <TextBlock x:Name="TxtSpeed" Grid.Row="2" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Top" HorizontalAlignment="Left"/>

                <!-- Footer Action Buttons for Step 2 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnOpenFolder" Height="32" Padding="12,0" Margin="0,0,8,0" Visibility="Collapsed"
                            Style="{StaticResource PrimarySettingsButton}"
                            Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_OpenFolder]}"
                            Click="BtnOpenFolder_Click"/>

                    <Button x:Name="BtnCloseProgress" Height="32" Padding="16,0" Width="80"
                            Style="{StaticResource SettingsButton}"
                            Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Cancel]}"
                            Click="BtnCloseProgress_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
