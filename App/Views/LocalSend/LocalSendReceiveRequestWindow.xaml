<Window x:Class="SwiftList.App.Views.LocalSend.LocalSendReceiveRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SwiftList.App.Services"
        Title="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_UploadRequestTitle]}"
        Height="360" Width="460" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1" CornerRadius="8" Margin="4">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="TitleBarLogo" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_UploadRequestTitle]}"
                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Header Device & File Summary -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock x:Name="TxtSender" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="TxtSummary" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- File List Preview -->
            <Border Grid.Row="2" Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Margin="0,0,0,16">
                <ListBox x:Name="LstFiles" Background="Transparent" BorderThickness="0" Margin="4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="4,3">
                                <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                           DockPanel.Dock="Left" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Action Buttons Footer -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnDecline" Grid.Column="0" Height="32" Width="90" HorizontalAlignment="Left"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Decline]}"
                        Click="BtnDecline_Click"/>

                <Button x:Name="BtnSaveTo" Grid.Column="1" Height="32" Padding="12,0" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_SaveTo]}"
                        Click="BtnSaveTo_Click"/>

                <Button x:Name="BtnAcceptDefault" Grid.Column="2" Height="32" Padding="16,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_AcceptDefault]}"
                        Click="BtnAcceptDefault_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
