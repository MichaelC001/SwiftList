<Window x:Class="SwiftList.App.Views.LocalSend.LocalSendSendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SwiftList.App.Services"
        xmlns:helpers="clr-namespace:SwiftList.App.Helpers.Visuals"
        Title="LocalSend"
        Width="460" MinWidth="420" MinHeight="280" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles/Windows/SearchWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ThemeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="true">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource ContentBg}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.25" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <Border CornerRadius="12" helpers:RoundedClip.IsEnabled="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="54"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Image x:Name="TitleBarLogo" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_SendWindowTitle]}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content Area -->
                <Grid Grid.Row="1" Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Device]}"
                                   FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                        <ListBox ItemsSource="{Binding DiscoveredDevices}" SelectedItem="{Binding SelectedDevice}"
                                 ItemContainerStyle="{StaticResource SidebarItemStyle}" MaxHeight="140" MinHeight="70"
                                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,2">
                                        <TextBlock Text="{Binding Alias}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding IpAddress}" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_TargetPin]}"
                                   FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding HasSelectedDevice}"
                                 Style="{StaticResource ThemeTextBoxStyle}" Height="28"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,4,0,0">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                        <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}" Maximum="100" Height="6"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Send]}"
                                Command="{Binding SendCommand}" Style="{StaticResource PrimarySettingsButton}" IsDefault="True" Width="85" Height="30"/>

                        <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Close]}"
                                Click="BtnClose_Click" Margin="8,0,0,0" Width="80" Height="30">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SettingsButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSending}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Cancel]}"
                                Command="{Binding CancelCommand}" Margin="8,0,0,0" Width="80" Height="30">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SettingsButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSending}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
