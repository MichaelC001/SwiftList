<Window x:Class="SwiftList.App.Views.LocalSend.LocalSendSendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SwiftList.App.Services"
        xmlns:helpers="clr-namespace:SwiftList.App.Helpers.Visuals"
        Title="LocalSend"
        Height="400" Width="480" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles/Windows/SearchWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ThemeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Height" Value="26"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                    <TextBlock x:Name="PlaceholderText" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_TargetPin]}" Margin="6,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{DynamicResource TextSecondary}" Opacity="0.55"
                                               FontSize="11" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="true">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MultiLineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Background" Value="{DynamicResource FieldBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="true">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RemoveItemButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#20FF4D4F"/>
                                    <Setter Property="Foreground" Value="#FF4D4F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SegmentRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Padding" Value="14,4"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ContentBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12" Background="{DynamicResource ContentBg}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Margin="8"
            AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.25" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <Border CornerRadius="12" helpers:RoundedClip.IsEnabled="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Title Bar -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Image x:Name="TitleBarLogo" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtWindowTitle" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_SendWindowTitle]}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- STEP 0: Content Collection (Files / Folders / Text) -->
                <Grid x:Name="GridStep0" Grid.Row="1" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="54"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,12,16,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top Segment / Mode Switcher -->
                        <Border Grid.Row="0" Margin="0,0,0,10" Background="{DynamicResource ControlBackground}"
                                CornerRadius="6" Padding="2" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RadioModeFiles" Content="发送文件 / 文件夹"
                                             IsChecked="{Binding IsFilesMode, Mode=OneWay}"
                                             Click="RadioModeFiles_Click" Style="{StaticResource SegmentRadioButtonStyle}"/>
                                <RadioButton x:Name="RadioModeText" Content="发送纯文本"
                                             IsChecked="{Binding IsTextMode, Mode=OneWay}"
                                             Click="RadioModeText_Click" Style="{StaticResource SegmentRadioButtonStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- Panel A: Files Mode -->
                        <Grid x:Name="PanelFilesMode" Grid.Row="1" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="BtnAddFiles" Content="添加文件" Click="BtnAddFiles_Click"
                                        Style="{StaticResource SettingsButton}" Height="28" Padding="12,0" Margin="0,0,8,0"/>
                                <Button x:Name="BtnAddFolder" Content="添加文件夹" Click="BtnAddFolder_Click"
                                        Style="{StaticResource SettingsButton}" Height="28" Padding="12,0"/>
                            </StackPanel>

                            <Border Grid.Row="1" Background="{DynamicResource FieldBackground}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1" CornerRadius="8">
                                <ListBox x:Name="LstCollectedItems" ItemsSource="{Binding CollectedItems}"
                                         Background="Transparent" BorderThickness="0" Margin="4"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="6,4" Margin="2,1">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                           ToolTip="{Binding Path}" FontSize="12"
                                                           Foreground="{DynamicResource TextPrimary2}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="&#xE74D;" Click="BtnRemoveCollectedItem_Click"
                                                        Style="{StaticResource RemoveItemButtonStyle}" ToolTip="移除"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>

                        <!-- Panel B: Text Mode -->
                        <Grid x:Name="PanelTextMode" Grid.Row="1" Visibility="Collapsed">
                            <TextBox Text="{Binding TextToSend, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MultiLineTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Padding="8,6" FontSize="12"/>
                        </Grid>
                    </Grid>

                    <!-- Step 0 Footer -->
                    <Border Grid.Row="1" Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Cancel]}"
                                    Click="BtnClose_Click" Style="{StaticResource SettingsButton}"
                                    Margin="0,0,8,0" Width="80" Height="30"/>
                            <Button x:Name="BtnNextStep" Content="下一步" Click="BtnNextStep_Click"
                                    Style="{StaticResource PrimarySettingsButton}" IsEnabled="{Binding CanGoNextStep}"
                                    Width="85" Height="30"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- STEP 1: Device List Selection with per-item PIN -->
                <Grid x:Name="GridStep1" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="54"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Device]}"
                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary2}" Margin="0,0,0,8"/>

                        <Border Grid.Row="1" Background="{DynamicResource FieldBackground}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1" CornerRadius="8">
                            <ListBox x:Name="LstDevices" ItemsSource="{Binding DiscoveredDevices}"
                                     SelectionMode="Multiple"
                                     SelectionChanged="LstDevices_SelectionChanged"
                                     Background="Transparent" BorderThickness="0" Margin="4"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Grid>
                                                        <Rectangle x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                                                   RadiusX="1.5" RadiusY="1.5" Fill="Transparent" Margin="2,4"/>
                                                        <Border x:Name="ItemBorder"
                                                                Background="Transparent"
                                                                CornerRadius="6"
                                                                Padding="8,6"
                                                                Margin="8,2,2,2">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectedBackground}"/>
                                                            <Setter TargetName="AccentBar" Property="Fill" Value="{DynamicResource AccentBarColor}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                        <DataTemplate>
                                        <Grid Margin="2,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Device type icon -->
                                            <Viewbox Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,4,0">
                                                <Path Fill="{DynamicResource TextSecondary}" Data="{Binding DeviceTypeIcon}" Stretch="Uniform"/>
                                            </Viewbox>

                                            <!-- Alias + model -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Alias}"
                                                           FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary2}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondary}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                                                    <Run Text="#"/><Run Text="{Binding FingerprintTag, Mode=OneWay}"/>
                                                    <Run Text=" · "/><Run Text="{Binding DeviceModel, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding IpAddress}"
                                                       FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"/>

                                            <TextBox Grid.Column="3" Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ThemeTextBoxStyle}" Height="26"
                                                     VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- Step 1 Footer -->
                    <Border Grid.Row="1" Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,0">
                        <Grid VerticalAlignment="Center">
                            <Button x:Name="BtnToggleSelectAll" Content="全选"
                                    Click="BtnToggleSelectAll_Click" Style="{StaticResource SettingsButton}"
                                    HorizontalAlignment="Left" Width="70" Height="30"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Cancel]}"
                                        Click="BtnClose_Click" Style="{StaticResource SettingsButton}"
                                        Margin="0,0,8,0" Width="80" Height="30"/>

                                <Button x:Name="BtnSend" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Send]}"
                                        Click="BtnSend_Click" Style="{StaticResource PrimarySettingsButton}"
                                        IsDefault="True" Width="85" Height="30" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- STEP 2: Transfer Progress -->
                <Grid x:Name="GridStep2" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="54"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,16,20,12">
                        <StackPanel VerticalAlignment="Center">
                            <Grid Margin="0,0,0,8">
                                <TextBlock x:Name="TxtFileName" Text="{Binding CurrentFileName}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" Width="300"/>
                                <TextBlock x:Name="TxtCounter" Text="{Binding CounterText}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <ProgressBar x:Name="PrgBar" Value="{Binding ProgressPercentage, Mode=OneWay}" Maximum="100" Height="6"
                                         Visibility="Collapsed"
                                         Foreground="{DynamicResource AccentBlue}" Background="{DynamicResource ControlBackground}"
                                         BorderThickness="0" Margin="0,0,0,12">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid x:Name="TemplateRoot">
                                            <Border CornerRadius="3" Background="{TemplateBinding Background}"/>
                                            <Border x:Name="PART_Track"/>
                                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{TemplateBinding Foreground}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>

                            <TextBlock x:Name="TxtSpeed" Text="{Binding SpeedText}"
                                       FontSize="12" Foreground="{DynamicResource AccentBlue}"
                                       HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>

                    <!-- Step 2 Footer -->
                    <Border Grid.Row="1" Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnCancelOrClose" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Cancel]}"
                                    Command="{Binding CancelCommand}" Click="BtnCancelOrClose_Click" Style="{StaticResource SettingsButton}"
                                    Width="80" Height="30"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
