<Window x:Class="SwiftList.App.Views.LocalSend.LocalSendSendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SwiftList.App.Services"
        xmlns:helpers="clr-namespace:SwiftList.App.Helpers.Visuals"
        Title="LocalSend Sender"
        Width="480" MinHeight="320" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles/Windows/SearchWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="10" Background="{DynamicResource ContentBg}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.2" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <Border CornerRadius="10" helpers:RoundedClip.IsEnabled="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Image x:Name="TitleBarLogo" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="LocalSend Send" 
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource TitleBarCloseButton}"
                                HorizontalAlignment="Right" Click="BtnClose_Click"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="20,16,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Device]}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding DiscoveredDevices}"
                                  SelectedItem="{Binding SelectedDevice}"
                                  DisplayMemberPath="Alias"
                                  Height="32"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_ReceivePin]}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SettingsTextBox}" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="{Binding StatusText}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                        <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="8"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Accept]}"
                                Command="{Binding SendCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Width="90" Height="30"/>
                        <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Close]}"
                                Click="BtnClose_Click" Style="{StaticResource SecondaryButtonStyle}" Width="80" Height="30"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
