<Window x:Class="SwiftList.App.Views.LocalSend.LocalSendProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SwiftList.App.Services"
        xmlns:helpers="clr-namespace:SwiftList.App.Helpers.Visuals"
        Title="LocalSend"
        Width="440" MinHeight="190" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles/Windows/SearchWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="10" Background="{DynamicResource ContentBg}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.2" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <Border CornerRadius="10" helpers:RoundedClip.IsEnabled="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Image x:Name="TitleBarLogo" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtTitle" Text="LocalSend" 
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content Area -->
                <Grid Grid.Row="1" Margin="20,16,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: Sender Info & File Index -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtSender" Text="" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary2}" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="TxtFileCount" Text="1/1" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- File Name -->
                    <TextBlock x:Name="TxtFileName" Grid.Row="1" Text="Filename.ext"
                               FontSize="12.5" Foreground="{DynamicResource TextPrimary2}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                    <!-- Progress Bar & Speed / Size -->
                    <StackPanel Grid.Row="2">
                        <ProgressBar x:Name="PbTransfer" Height="6" Minimum="0" Maximum="100" Value="0"
                                     Foreground="{DynamicResource AccentBlue}" Background="{DynamicResource BorderColor}"
                                     BorderThickness="0" Margin="0,0,0,8"/>
                        <DockPanel>
                            <TextBlock x:Name="TxtSpeed" Text="0 MB/s" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondary}" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="TxtSize" Text="0 MB / 0 MB" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>

                <!-- Button Bar -->
                <Border Grid.Row="2" Background="{DynamicResource StatusBarBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
                    <Grid Margin="12,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnOpenFolder" Style="{StaticResource PrimarySettingsButton}" 
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_OpenFolder]}" 
                                    Width="110" Height="28" Margin="0,0,8,0" Click="BtnOpenFolder_Click" Visibility="Collapsed"/>
                            <Button x:Name="BtnClose" Style="{StaticResource SettingsButton}" 
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Cancel]}" 
                                    Width="80" Height="28" Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
