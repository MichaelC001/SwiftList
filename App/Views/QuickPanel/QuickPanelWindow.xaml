<Window x:Class="SwiftList.App.Views.QuickPanel.QuickPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:SwiftList.App.Views.Controls"
        xmlns:services="clr-namespace:SwiftList.App.Services"
        xmlns:helpers="clr-namespace:SwiftList.App.Helpers.Visuals"
        xmlns:local="clr-namespace:SwiftList.App.Views.QuickPanel"
        xmlns:app="clr-namespace:SwiftList.App"
        Title="SwiftList Quick Panel"
        Width="330" Height="300" SizeToContent="Manual"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        ShowActivated="False">
    <!-- Every window property above is the inline search window's, deliberately: this is the same kind
         of thing, a panel that appears over someone else's window and leaves on its own. ShowActivated
         False is the load-bearing one, since taking the foreground would move focus off the very window
         this docks itself to. -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <!-- TabHeaderButtonStyle/TabUnderlineStyle live here, and StaticResource only fails at
                     runtime, so leaving this out built cleanly and crashed on first open. -->
                <ResourceDictionary Source="../../Resources/Styles/Windows/SettingsWindow.xaml"/>
                <!-- Kept though the tile template is defined locally: this dictionary also supplies
                     implicit templates and converters the shared styles above reach for, and a
                     StaticResource that goes missing only fails when the window is opened. -->
                <ResourceDictionary Source="../../Resources/DataTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>


            <!-- The full window's row, rebuilt for a ListBox. SearchResultItemStyle itself cannot be
                 reused: it targets ListViewItem and presents through a GridViewRowPresenter, neither of
                 which a plain ListBox has. Everything that makes it behave the way it does is here,
                 though, and none of it is what ResultItemStyle does.

                 A real IsMouseOver trigger, so hovering highlights without selecting. ResultItemStyle
                 has none, because the lists it was written for select on hover instead and take their
                 highlight from IsSelected; that indirection is also what kept fighting multi-selection
                 here, and with a genuine hover trigger there is nothing left to fight.

                 Plain Setters, no EnterActions or ExitActions. ResultItemStyle animates the selection
                 fade, which is the flicker on every click this panel had and the full window does not. -->
            <Style x:Key="QuickPanelRowStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <!-- The full window's own row height, which is what these should match. ItemHeight, the
                     other candidate, is sized for a large icon plus breathing room and made the rows
                     tower over everything. MinHeight rather than Height so a row can still grow if its
                     own content ever needs to. -->
                <Setter Property="MinHeight" Value="{x:Static services:UiMetrics.ListItemHeight}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Rectangle x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                           RadiusX="1.5" RadiusY="1.5" Fill="Transparent" Margin="0,2"/>
                                <Border x:Name="ItemBorder" Background="Transparent"
                                        CornerRadius="6" Margin="6,2,6,2" Padding="12,0,12,0" Cursor="Hand">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ItemHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ItemHover}"/>
                                    <Setter TargetName="AccentBar" Property="Fill" Value="{DynamicResource AccentBarColor}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>



            <local:ModifiedTimeConverter x:Key="ModifiedTime"/>

            <!-- The detail row. Not the shared SearchResultTemplate, which draws the path underneath the
                 name: the path is already in the group's own header, once, and repeating it on every row
                 of that group says nothing. The modified time goes there instead, bound rather than
                 written onto the item, so a row whose time the index has yet to learn fills itself in
                 when it arrives. -->
            <DataTemplate x:Key="QuickPanelDetailRowTemplate" DataType="{x:Type app:AppSearchResult}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20"
                           Margin="0,0,10,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding DateModified, Converter={StaticResource ModifiedTime}}"
                                   FontSize="10" Margin="0,1,0,0"
                                   Foreground="{DynamicResource TextSecondary2}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- The sort switch, in each group header. Its glyph names the order it would GIVE you,
                 same as the view switch below and for the same reason. -->
            <Style x:Key="QuickPanelSortToggleStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="ToolTip" Value="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_SortByName]}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                <TextBlock x:Name="Glyph" Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="10" Foreground="{DynamicResource TextSecondary2}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHover}"/>
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding SortMode}" Value="NameAscending">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE81C;"/>
                                    <Setter Property="ToolTip" Value="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_SortByModified]}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The view switch. Its glyph shows what pressing it gives you, not what you are looking
                 at: a list icon while the tiles are up, tiles while the list is. A toggle that pictures
                 the current state reads as a label and leaves the button looking inert. -->
            <Style x:Key="QuickPanelViewToggleStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="ToolTip" Value="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_ViewList]}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                <TextBlock x:Name="Glyph" Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="10" Foreground="{DynamicResource TextSecondary2}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHover}"/>
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsThumbnailView}" Value="False">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE80A;"/>
                                    <Setter Property="ToolTip" Value="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_ViewThumbnails]}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A thumbnail tile. Icon binds to the same property the list rows use, which already
                 resolves through ShellIconHelper and whatever thumbnail providers are installed, so
                 nothing new fetches images: this is the same picture at a size worth looking at.
                 The name is allowed two lines before it is cut, a file called something long being the
                 normal case rather than the exception at this width. -->
            <DataTemplate x:Key="QuickPanelTileTemplate" DataType="{x:Type app:AppSearchResult}">
                <StackPanel Width="84" Margin="2,4,2,4">
                    <Image Source="{Binding Icon}" Width="48" Height="48"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Name}" FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="30" TextAlignment="Center"/>
                </StackPanel>
            </DataTemplate>

            <!-- The tile's container. Not the row style: that one stretches to the full width and draws a
                 left accent bar, both of which are for a list. A tile sizes to itself and takes the
                 highlight as a rounded box around the whole thing. -->
            <Style x:Key="QuickPanelTileStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="TileBorder" Background="Transparent" CornerRadius="6"
                                    Margin="2" Padding="2" Cursor="Hand">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource ItemHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource ItemHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The group header's own toggle. WPF's stock Expander draws a circled chevron from the
                 system theme, which answers to none of this app's brushes and sat in the panel looking
                 like it came from another program.
                 The whole bar is the button, not just the glyph: it is a wide, thin target and the
                 chevron alone is a small one, and clicking a header to collapse what is under it is the
                 behaviour the bar as a whole implies. -->
            <Style x:Key="QuickPanelGroupToggleStyle" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bar" Background="Transparent" CornerRadius="6" Padding="8,3,8,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="Chevron" Grid.Column="0"
                                               Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                               Foreground="{DynamicResource TextSecondary2}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>

                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ItemHover}"/>
                                </Trigger>
                                <!-- Chevron up once open, so it points at what collapsing would do. -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="QuickPanelGroupExpanderStyle" TargetType="Expander">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <StackPanel>
                                <ToggleButton Style="{StaticResource QuickPanelGroupToggleStyle}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Content="{TemplateBinding Header}"/>
                                <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="10" Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.2" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <Border CornerRadius="10" helpers:RoundedClip.IsEnabled="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Drag strip, no title: the panel says what it is by what it shows, but it still needs
                     somewhere to grab, and every other surface here is a tab or a row that does its own
                     thing on click.

                     Same construction as the full window's header drag area: the themed brush goes on
                     the Border and the handler on a Transparent child, because an element with a null
                     Background is not hit-testable at all, so hanging the drag region off a themed brush
                     would make it vanish under any theme that did not define one. -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        VerticalAlignment="Top" Panel.ZIndex="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="Height" Value="14"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Height" Value="20"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid x:Name="DragArea" Height="14" Background="Transparent"
                          MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                        <Border Width="36" Height="3" CornerRadius="1.5"
                                Background="{DynamicResource SeparatorBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </Grid>
                </Border>

                <!-- Tab strip. TabStripScrollView, same as the quick window's own startup panel strip:
                     the tabs are user-configurable and their labels are translated, so the row can
                     overflow a panel this narrow and needs its left/right arrows. -->
                <ctrl:TabStripScrollView Grid.Row="0" Margin="12,16,12,0">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,20,0">
                                    <Button Content="{Binding Label}" Command="{Binding SelectCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ctrl:TabStripScrollView>


                <Border Grid.Row="1" Background="{DynamicResource ContentBg}">
                    <Grid>
                        <!-- One block per folder, each with its own header and its own list. Deliberately
                             not a CollectionView's grouping, which is simpler and is what this used
                             before: sorting on a view is a property of the whole view, so every group
                             would share one order, and the order is meant to be per folder.

                             What that costs is stated where the group view model is defined: a selection
                             now belongs to one folder rather than spanning them. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,4,0,8">
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                  Style="{StaticResource QuickPanelGroupExpanderStyle}">
                                            <Expander.Header>
                                                <Grid Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBlue}"
                                                               VerticalAlignment="Center" Text="{Binding LeafName}"/>

                                                    <TextBlock Grid.Column="1" FontSize="11" Margin="6,0,0,0"
                                                               Foreground="{DynamicResource TextSecondary2}"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Count, StringFormat=({0})}"/>

                                                    <TextBlock Grid.Column="2" FontSize="11" Margin="10,0,0,0"
                                                               Foreground="{DynamicResource TextSecondary2}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding FolderPath}"/>

                                                    <!-- The rule carries the heading across to the sort
                                                         button. It takes the Star column and the path
                                                         takes Auto: the other way round, a long path
                                                         would squeeze the line out of existence, and the
                                                         line is the part that can be any length without
                                                         losing anything. -->
                                                    <Border Grid.Column="3" Height="1" Margin="10,0,10,0"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource SeparatorBrush}"/>

                                                    <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Click="SortToggle_Click"
                                                                Style="{StaticResource QuickPanelSortToggleStyle}"/>
                                                        <Button Click="ViewToggle_Click" Margin="2,0,0,0"
                                                                Style="{StaticResource QuickPanelViewToggleStyle}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Expander.Header>

                                            <!-- Its own scrolling is off: the groups scroll together in
                                                 the viewer above, and a list that scrolled inside a group
                                                 would trap the wheel in whichever one the pointer
                                                 happened to be over.

                                                 A view mode is three things at once and they are swapped
                                                 together, since any one alone would leave the other two
                                                 describing the view it is not. Read straight off the
                                                 group now: which view suits a folder is a property of
                                                 that folder, the same as its order. -->
                                            <ListBox ItemsSource="{Binding Items}"
                                                     Background="Transparent" BorderThickness="0" Padding="0"
                                                     Margin="0,2,0,6"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                     VerticalContentAlignment="Center"
                                                     SelectionMode="Extended"
                                                     MouseDoubleClick="ItemsList_MouseDoubleClick"
                                                     PreviewMouseRightButtonUp="ItemsList_PreviewMouseRightButtonUp"
                                                     Loaded="GroupList_Loaded"
                                                     PreviewMouseWheel="GroupList_PreviewMouseWheel">
                                                <ListBox.Style>
                                                    <Style TargetType="ListBox" BasedOn="{StaticResource SleekListBoxStyle}">
                                                        <Setter Property="ItemContainerStyle" Value="{StaticResource QuickPanelRowStyle}"/>
                                                        <Setter Property="ItemTemplate" Value="{StaticResource QuickPanelDetailRowTemplate}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True"
                                                                         Binding="{Binding IsThumbnailView}">
                                                                <Setter Property="ItemContainerStyle" Value="{StaticResource QuickPanelTileStyle}"/>
                                                                <Setter Property="ItemTemplate" Value="{StaticResource QuickPanelTileTemplate}"/>
                                                                <Setter Property="ItemsPanel">
                                                                    <Setter.Value>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Orientation="Horizontal"/>
                                                                        </ItemsPanelTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.Style>
                                            </ListBox>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Shown when the tab on screen has nothing in it. The panel not opening at all
                             covers the case where nothing anywhere has anything; this covers the one
                             where it opened for another tab's sake and this one is bare. -->
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_Empty]}"
                                   Foreground="{DynamicResource TextSecondary2}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
