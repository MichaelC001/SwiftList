<UserControl x:Class="SwiftList.App.Views.Settings.Plugins.PluginCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:SwiftList.App.Services"
             xmlns:conv="clr-namespace:SwiftList.App.Converters"
             xmlns:local="clr-namespace:SwiftList.App.Views.Settings.Plugins"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="660">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>

        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
        <StackPanel>

            <!-- Plugin header row. No longer clickable: this card is the detail pane for whichever
                 plugin the list on the left has selected, so there is nothing left for clicking it to
                 expand into. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Plugin icon (fallback glyph shown when a plugin has no icon of its
                     own). BadgeBackground/BadgeText is a neutral gray meant for small
                     text pills (see the SDK version badge above); reusing it as a
                     36x36 tile fill made the icon read as flat/washed-out next to this
                     page's still-colorful checkboxes and buttons, so the tile itself
                     stays neutral (HoverBackground) while the glyph keeps the accent
                     color, matching the common "neutral tile, colored icon" pattern. -->
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                        Background="{DynamicResource HoverBackground}" Margin="0,0,12,0">
                    <TextBlock Text="&#xECAA;" FontFamily="Segoe MDL2 Assets"
                               FontSize="16" Foreground="{DynamicResource AccentBlue}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Name + meta -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <!-- The description, which used to be a tooltip behind a small (!) badge. There is
                         room for it here now that the pane shows one plugin at a time, and a plugin's
                         own summary is the thing most worth reading before deciding anything about it.
                         The version and DLL name that used to sit on this line are gone: the version is
                         already on this plugin's row in the list to the left, and the file name is
                         detail nobody needs while choosing what to enable. -->
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondary2}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Description}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

            </Grid>

            <!-- Details / Config tabs. Config used to be a button that revealed a section below the
                 components; a plugin's settings and the list of what it provides are separate things to
                 look at, so they get a tab each rather than stacking down one pane. Same tab-strip
                 styling as the Index and Hotkeys pages. A plugin with no config fields would leave the
                 strip showing a lone Details tab, so the whole strip hides in that case. -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                        Visibility="{Binding HasConfigFields, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,28,0">
                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_TabDetails]}"
                            Command="{Binding ShowDetailsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConfigTab}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConfigTab}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
                <StackPanel>
                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Configure]}"
                            Command="{Binding ShowConfigCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConfigTab}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConfigTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Config tab -->
            <local:PluginConfigSection Visibility="{Binding IsConfigTab, Converter={StaticResource BoolToVis}}"/>

            <!-- Details tab: the components this plugin provides. -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding IsConfigTab, Converter={StaticResource InvertBoolToVis}}">

                <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_ComponentsTitle]}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary2}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="{Binding SelectAllToggleLabel}" Command="{Binding ToggleAllComponentsCommand}"
                            Style="{StaticResource LinkButton}" FontSize="11"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding HasToggleableComponents, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- No components placeholder -->
                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_NoComponents]}"
                           Foreground="{DynamicResource TextSecondary2}" FontSize="12"
                           Visibility="{Binding HasNoComponents, Converter={StaticResource BoolToVis}}"/>

                <!-- Component Groups -->
                <ItemsControl ItemsSource="{Binding ComponentGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,14">
                                <!-- Group Header -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border Width="3" Height="12" CornerRadius="1"
                                                Background="{Binding ComponentType, Converter={StaticResource TypeToBrush}}"
                                                Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding GroupName}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding ComponentType, Converter={StaticResource TypeToBrush}}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding SelectAllToggleLabel}" Command="{Binding ToggleAllCommand}"
                                            Style="{StaticResource LinkButton}" FontSize="11"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Visibility="{Binding HasToggleableComponents, Converter={StaticResource BoolToVis}}"/>
                                </Grid>

                                <!-- Nested components -->
                                <ItemsControl ItemsSource="{Binding Components}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SettingsRow}" Padding="8,6" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="28"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding DisplayName}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               VerticalAlignment="Center"/>

                                                    <!-- Info button (!) -->
                                                    <Border Grid.Column="1" Width="14" Height="14" CornerRadius="7"
                                                            Background="{DynamicResource HoverBackground}"
                                                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Help">
                                                        <Border.ToolTip>
                                                            <ToolTip MaxWidth="300">
                                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Description}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="!" FontSize="9" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextSecondary2}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                    </Border>

                                                    <!-- CheckBox shown for toggleable components -->
                                                    <CheckBox Grid.Column="2"
                                                              IsChecked="{Binding IsEnabled}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Visibility="{Binding IsToggleable, Converter={StaticResource BoolToVis}}"/>

                                                    <!-- Lock icon shown for read-only components (e.g. TranslationProvider) -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="&#xE72E;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource SeparatorBrush}"
                                                               ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_ReadOnlyTooltip]}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IsToggleable, Converter={StaticResource InvertBoolToVis}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                             </StackPanel>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
             </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
