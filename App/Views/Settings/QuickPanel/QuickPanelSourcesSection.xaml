<UserControl x:Class="SwiftList.App.Views.Settings.QuickPanel.QuickPanelSourcesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:SwiftList.App.Services"
             xmlns:core="clr-namespace:SwiftList.Core;assembly=SwiftList.Core"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="520">
    <!-- Split out of QuickPanelSettingsPage.xaml to keep that file under the project's line-count
         convention. DataContext is the selected QuickPanelTabSettingsViewModel, handed down by the host
         page, so every binding here is one of its members. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- One row per source, which is one group in the panel. The row itself stays scannable:
                 shown/hidden, name, where it comes from. Everything that needs a decision rather than
                 a glance sits behind the chevron, so a list of eight folders is still readable. -->
            <DataTemplate x:Key="SourceRowTemplate">
                <Border BorderBrush="{DynamicResource SettingsRowBorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"
                                      ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_SourceVisibleTooltip]}"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid>
                                    <TextBox Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource RuleTextBox}"
                                             ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_SourceNameTooltip]}"/>
                                    <!-- The name this group will actually carry, shown while the box is
                                         empty. Without it an unrenamed row is a blank rectangle, and
                                         the built-in sources have no path underneath to hint at it. -->
                                    <TextBlock Text="{Binding DefaultName}" IsHitTestVisible="False"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DisplayName}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="{Binding Path}" Style="{StaticResource SettingsHintText}"
                                           TextTrimming="CharacterEllipsis" Margin="2,3,0,0"
                                           Visibility="{Binding IsFolderSource, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="&#xE70E;"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_MoveUpTooltip]}"
                                        Style="{StaticResource RuleIconButton}"
                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="&#xE70D;"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_MoveDownTooltip]}"
                                        Style="{StaticResource RuleIconButton}"
                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                              Content="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                              Width="28" Height="28" Background="Transparent" BorderThickness="0"
                                              Foreground="{DynamicResource TextPrimary2}"
                                              ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_SourceOptionsTooltip]}"
                                              Visibility="{Binding IsFolderSource, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="&#xE74D;"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_RemoveSourceTooltip]}"
                                        Style="{StaticResource RuleIconButton}"
                                        Visibility="{Binding IsFolderSource, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Only a folder source has any of this, and only when asked for. -->
                        <Grid Margin="26,8,0,4" Grid.IsSharedSizeScope="True">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                                <Condition Binding="{Binding IsFolderSource}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="QuickPanelFieldLabel"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_SourceKind]}"
                                       VerticalAlignment="Center" Margin="0,0,12,6"/>
                            <ComboBox Grid.Column="1" Margin="0,0,0,6" HorizontalAlignment="Left" MinWidth="180"
                                      SelectedValue="{Binding Kind, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem Tag="{x:Static core:QuickPanelSourceKind.RecentFiles}"
                                              Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_KindRecentFiles]}"/>
                                <ComboBoxItem Tag="{x:Static core:QuickPanelSourceKind.Launcher}"
                                              Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_KindLauncher]}"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_SourcePath]}"
                                       VerticalAlignment="Center" Margin="0,0,12,6"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource RuleTextBox}"
                                     Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,6"
                                      IsChecked="{Binding Recursive, Mode=TwoWay}"
                                      Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_Recursive]}"/>

                            <TextBlock Grid.Row="3" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_FilterPattern]}"
                                       VerticalAlignment="Center" Margin="0,0,12,6"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource RuleTextBox}"
                                     ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_FilterPatternTooltip]}"
                                     Text="{Binding FilterPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal">
                                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_MaxItems]}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Width="70" Style="{StaticResource RuleTextBox}"
                                         Text="{Binding MaxItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>
                                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_MaxAge]}"
                                           VerticalAlignment="Center" Margin="16,0,8,0"
                                           Visibility="{Binding IsRecentFiles, Converter={StaticResource BoolToVis}}"/>
                                <TextBox Width="70" Style="{StaticResource RuleTextBox}"
                                         Visibility="{Binding IsRecentFiles, Converter={StaticResource BoolToVis}}"
                                         Text="{Binding MaxAgeMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right"
                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_AddFolder]}"
                    Style="{StaticResource PrimarySettingsButton}"
                    Command="{Binding AddFolderCommand}"/>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_SourcesDesc]}"
                       Style="{StaticResource SettingsHintText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
        </DockPanel>

        <!-- Scrolls inside its own pane: a workspace with a dozen sources, or one row expanded, must
             not stretch the card past the bottom of the window. -->
        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListQuickPanelSources" ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource SourceRowTemplate}"/>
        </ScrollViewer>
    </StackPanel>
</UserControl>
